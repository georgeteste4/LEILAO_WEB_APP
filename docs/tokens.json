{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "UniversalDesignSystemTokens",
  "version": "2.0.0",
  "description": "Design tokens semânticos universais para aplicações corporativas, SaaS, e-commerce e dashboards.",
  "color": {
    "light": {
      "bgCanvas": "#f8fafc",
      "bgSurface": "#ffffff",
      "borderSubtle": "#e2e8f0",
      "textMain": "#0f172a",
      "textMuted": "#64748b",
      "brand": "#0284c7",
      "brandHover": "#0369a1",
      "success": "#059669",
      "danger": "#e11d48",
      "warning": "#d97706",
      "info": "#3b82f6"
    },
    "dark": {
      "bgCanvas": "#090d16",
      "bgSurface": "#0f172a",
      "borderSubtle": "#1e293b",
      "textMain": "#f8fafc",
      "textMuted": "#94a3b8",
      "brand": "#38bdf8",
      "brandHover": "#7dd3fc",
      "success": "#10b981",
      "danger": "#fb7185",
      "warning": "#f59e0b",
      "info": "#60a5fa"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "\"Manrope\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace"
    },
    "letterSpacing": {
      "body": "-0.011em",
      "heading": "-0.022em",
      "mono": "-0.02em"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "spacing": {
    "cardPadding": "0.875rem",
    "sectionGap": "1.5rem",
    "borderRadius": "0.75rem",
    "tagBorderRadius": "0.375rem",
    "buttonRadius": "0.5rem"
  },
  "elevation": {
    "cardHoverLight": "0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05)",
    "cardHoverDark": "0 12px 30px -8px rgba(0, 0, 0, 0.5)",
    "modalShadow": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
  }
}
